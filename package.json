{
  "name": "@lachimere/volare",
  "version": "0.2.0",
  "description": "Local agent-runtime bridge backed by Copilot CLI, currently exposing an OpenAI Responses-compatible API.",
  "module": "src/index.ts",
  "type": "module",
  "private": false,
  "packageManager": "bun@1.3.13",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaChimere/volare.git"
  },
  "homepage": "https://github.com/LaChimere/volare#readme",
  "bugs": {
    "url": "https://github.com/LaChimere/volare/issues"
  },
  "keywords": [
    "agent",
    "bun",
    "cli",
    "codex",
    "copilot",
    "openai-responses"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "volare": "src/cli.ts"
  },
  "files": [
    "src",
    "scripts/config-codex.ts",
    "docs",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && tsc --noEmit",
    "fix": "biome check --write .",
    "config:codex": "bun run scripts/config-codex.ts",
    "package": "bun build --compile src/cli.ts --outfile dist/volare",
    "hooks:install": "lefthook install",
    "hooks:run": "lefthook run pre-commit --force",
    "ci": "biome ci . && tsc --noEmit && bun run test:unit && bun run test:integration",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test tests/unit_tests --pass-with-no-tests",
    "test:integration": "bun test tests/integration_tests --timeout=30000 --pass-with-no-tests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/bun": "latest",
    "lefthook": "^2.1.6",
    "typescript": "^6"
  },
  "dependencies": {
    "pino": "^10.3.1"
  }
}
