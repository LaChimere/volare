{
  "name": "@lachimere/volare",
  "version": "0.4.0",
  "description": "Local agent-runtime bridge backed by Copilot CLI, currently exposing an OpenAI Responses-compatible API.",
  "module": "src/index.ts",
  "type": "module",
  "private": false,
  "packageManager": "bun@1.3.13",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaChimere/volare.git"
  },
  "homepage": "https://github.com/LaChimere/volare#readme",
  "bugs": {
    "url": "https://github.com/LaChimere/volare/issues"
  },
  "keywords": [
    "agent",
    "bun",
    "cli",
    "codex",
    "copilot",
    "openai-responses"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "volare": "src/cli.ts"
  },
  "files": [
    "src",
    "scripts/config-codex.ts",
    "docs",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && tsc --noEmit",
    "fix": "biome check --write .",
    "config:codex": "bun run scripts/config-codex.ts",
    "package": "mkdir -p builds && cd builds && bun build --compile ../src/cli.ts --outfile volare",
    "hooks:install": "lefthook install",
    "hooks:run": "lefthook run pre-commit --force",
    "ci": "biome ci . && tsc --noEmit && bun run test:unit && bun run test:component && bun run test:integration && bun run test:integration:http && bun run test:integration:backend && bun run test:integration:durable && bun run test:contract && bun run test:security",
    "test": "bun run test:unit && bun run test:component && bun run test:integration && bun run test:integration:http && bun run test:integration:backend && bun run test:integration:durable && bun run test:contract && bun run test:security",
    "test:unit": "bun run test:unit:legacy && bun run test:unit:target",
    "test:unit:legacy": "bun test tests/unit_tests --pass-with-no-tests",
    "test:unit:target": "test -n \"$(find tests/unit -name '*.test.ts' -print -quit)\" && bun test $(find tests/unit -name '*.test.ts' -print)",
    "test:component": "test -n \"$(find tests/component -name '*.test.ts' -print -quit)\" && bun test $(find tests/component -name '*.test.ts' -print)",
    "test:integration": "bun test tests/integration_tests --timeout=30000 --pass-with-no-tests",
    "test:integration:http": "test -n \"$(find tests/integration/http -name '*.test.ts' -print -quit)\" && bun test $(find tests/integration/http -name '*.test.ts' -print) --timeout=30000",
    "test:integration:backend": "test -n \"$(find tests/integration/backend -name '*.test.ts' -print -quit)\" && bun test $(find tests/integration/backend -name '*.test.ts' -print) --timeout=30000",
    "test:integration:durable": "test -n \"$(find tests/integration/durable -name '*.test.ts' -print -quit)\" && bun test $(find tests/integration/durable -name '*.test.ts' -print) --timeout=30000",
    "test:integration:mock": "bun run test:integration:http",
    "test:contract": "test -n \"$(find tests/contract -name '*.test.ts' -print -quit)\" && bun test $(find tests/contract -name '*.test.ts' -print)",
    "test:security": "test -n \"$(find tests/security -name '*.test.ts' -print -quit)\" && bun test $(find tests/security -name '*.test.ts' -print)",
    "test:e2e:codex": "bun test tests/integration_tests/codex-cli-e2e.test.ts --timeout=30000"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/bun": "latest",
    "lefthook": "^2.1.6",
    "typescript": "^6"
  },
  "dependencies": {
    "pino": "^10.3.1"
  }
}
